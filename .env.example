APP_NAME=Giftnify
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Local: sqlite. Production: mysql or pgsql (see DEPLOY.md)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=giftnify
# DB_USERNAME=giftnify
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# sync = send messages inside the request (fine to start). database = background worker (recommended).
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=giftnify_

# ---------------------------------------------------------------------------
# Payments
# Demo payments mark gifts paid WITHOUT charging. Never true on the live site.
PAYMENTS_ALLOW_DEMO=true

# Paystack — Naira (cards, bank transfer, USSD). Also used to check bank account names.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave — GBP, EUR and USD cards from abroad.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Which provider collects each currency (empty = currency switched off)
PAYMENT_ROUTE_NGN=paystack
PAYMENT_ROUTE_USD=flutterwave
PAYMENT_ROUTE_GBP=flutterwave
PAYMENT_ROUTE_EUR=flutterwave
PAYMENT_ROUTE_CAD=

# ---------------------------------------------------------------------------
# Delivery
# SMS / WhatsApp through Termii (leave the key empty to offer Link only)
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=Giftnify
# Name of the WhatsApp device connected in Termii (empty = no WhatsApp option)
TERMII_WHATSAPP_DEVICE=

# Email (gift delivery, sender alerts, codes, password resets).
# log = emails are not sent. Use smtp (any provider), or resend/postmark/ses.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@giftnify.app"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AI (hints, message writing, Giftgenie ideas). Empty = written fallbacks / labelled examples.
OPENAI_API_KEY=
LOVABLE_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# ---- Giftnify app (src/, runs on http://localhost:3000) ----
# Addresses of the app that may use the website API (comma-separated).
# The phone apps (https://localhost, capacitor://localhost) are always allowed.
APP_CLIENT_URLS=http://localhost:3000,http://127.0.0.1:3000
# The app reads this to find the website (set it where you run "npm run app:dev" / "app:build").
VITE_API_URL=http://localhost:8000
